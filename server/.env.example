PORT=5000

# ============================================================
# MONGODB CONNECTION STRING
# ============================================================
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/vedanco_ai

# MongoDB Atlas (Cloud) - replace <username>, <password>, and <cluster-url>:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/vedanco_ai?retryWrites=true&w=majority

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development

# ============================================================
# OPTIONAL: VOICE AI & TELEPHONY INTEGRATIONS
# ============================================================
OPENAI_API_KEY=
VAPI_API_KEY=
RETELL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
